{
  "baseUrl": "https://www.gattex.com",

  "pages": [
    {
      "id": "home",
      "label": "Home Page",
      "path": "/",
      "includesEntry": true,
      "entryActions": [
        { "type": "acceptCookies" }
      ],
      "steps": [
        {
          "id": "with-overlays",
          "enabled": true,
          "label": "Cookie bar, message bar & ISI tray",
          "description": "Raw entry state — all overlays visible before any interaction",
          "phase": "pre-entry",
          "captureMode": "viewport",
          "desktop": { "width": 1442, "height": 900 },
          "mobile":  { "width": 390,  "height": 800 },
          "includeMobile": true
        },
        {
          "id": "message-bar-isi-open",
          "enabled": true,
          "label": "Message bar & ISI tray open",
          "description": "Cookie dismissed — message bar and ISI tray both visible at default size",
          "phase": "post-entry",
          "captureMode": "viewport",
          "desktop": { "width": 1442, "height": 900 },
          "mobile":  { "width": 390,  "height": 800 },
          "includeMobile": true
        },
        {
          "id": "isi-minimized",
          "enabled": true,
          "label": "ISI tray minimized",
          "description": "Dismiss message bar, minimize ISI tray, capture viewport",
          "phase": "authenticated",
          "captureMode": "viewport",
          "desktop": { "width": 1442, "height": 900 },
          "mobile":  { "width": 390,  "height": 800 },
          "includeMobile": true,
          "captureHamburger": true,
          "actions": [
            { "type": "click", "selector": ".message-bar .close" },
            { "type": "click", "selector": ".floating-isi .toggle-expand" }
          ]
        },
        {
          "id": "full-page",
          "enabled": true,
          "label": "Full page",
          "description": "Complete scroll capture with ISI tray hidden",
          "phase": "authenticated",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true
        }
      ]
    },

    {
      "id": "short-bowel-syndrome",
      "label": "Short Bowel Syndrome",
      "path": "/short-bowel-syndrome/",
      "steps": [
        {
          "id": "full-page",
          "enabled": true,
          "label": "Full page",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true
        }
      ]
    },

    {
      "id": "short-bowel-syndrome-management",
      "label": "SBS Management",
      "path": "/short-bowel-syndrome-management/",
      "steps": [
        {
          "id": "full-page",
          "enabled": true,
          "label": "Full page",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true
        }
      ]
    },

    {
      "id": "gut-check-questionnaire",
      "label": "Gut Check Questionnaire",
      "path": "/gut-check-questionnaire/",
      "steps": [
        {
          "id": "screen-1-default",
          "enabled": true,
          "label": "Screen 1 — Default landing",
          "captureMode": "element",
          "selector": "section.gut-check-questionnaire",
          "hideISI": true,
          "includeMobile": false
        },
        {
          "id": "screen-2-adult-sbs",
          "enabled": true,
          "label": "Screen 2 — Adult with SBS diagnosis selected",
          "captureMode": "element",
          "selector": "section.gut-check-questionnaire",
          "hideISI": true,
          "includeMobile": false,
          "actions": [
            { "type": "click", "selector": "a.button.begin-questionnaire" },
            { "type": "click", "selector": "label.image-input:has(input[value='Adult'])" },
            { "type": "click", "selector": "label:has(#AdultSBS)" }
          ]
        },
        {
          "id": "screen-3-symptoms",
          "enabled": true,
          "label": "Screen 3 — Symptoms (1 of 5)",
          "captureMode": "element",
          "selector": "section.gut-check-questionnaire",
          "hideISI": true,
          "includeMobile": false,
          "actions": [
            { "type": "click", "selector": "a.button.next" },
            { "type": "click", "selector": "label[for='AdultSymptoms-Malnutrition']" }
          ]
        },
        {
          "id": "screen-4-ps-volume",
          "enabled": true,
          "label": "Screen 4 — PS volume (2 of 5)",
          "captureMode": "element",
          "selector": "section.gut-check-questionnaire",
          "hideISI": true,
          "includeMobile": false,
          "actions": [
            { "type": "click", "selector": "a.button.next" },
            { "type": "input", "selector": "#AdultPSVolume", "value": "1000" }
          ]
        },
        {
          "id": "screen-5-activities",
          "enabled": true,
          "label": "Screen 5 — Activities (3 of 5)",
          "captureMode": "element",
          "selector": "section.gut-check-questionnaire",
          "hideISI": true,
          "includeMobile": false,
          "actions": [
            { "type": "click", "selector": "a.button.next" },
            { "type": "click", "selector": "label[for='AdultActivities-Hobbies']" }
          ]
        },
        {
          "id": "screen-6-complications",
          "enabled": true,
          "label": "Screen 6 — Complications (4 of 5)",
          "captureMode": "element",
          "selector": "section.gut-check-questionnaire",
          "hideISI": true,
          "includeMobile": false,
          "actions": [
            { "type": "click", "selector": "a.button.next" },
            { "type": "click", "selector": "section.gut-check-questionnaire label.custom-input" }
          ]
        },
        {
          "id": "screen-7-goals",
          "enabled": true,
          "label": "Screen 7 — Goals (5 of 5)",
          "captureMode": "element",
          "selector": "section.gut-check-questionnaire",
          "hideISI": true,
          "includeMobile": false,
          "actions": [
            { "type": "click", "selector": "a.button.next" },
            { "type": "click", "selector": "label[for='AdultSureGoals-Informed']" }
          ]
        },
        {
          "id": "screen-8-results",
          "enabled": true,
          "label": "Screen 8 — You're all set",
          "captureMode": "element",
          "selector": "section.gut-check-questionnaire",
          "hideISI": true,
          "includeMobile": false,
          "actions": [
            { "type": "click", "selector": "a.button.next, a.button.review, a.button.view-responses, a.button.view_responses" }
          ]
        }
      ]
    },

    {
      "id": "sign-up",
      "label": "Sign Up",
      "path": "/sign-up/",
      "steps": [
        {
          "id": "full-page",
          "enabled": true,
          "label": "Full page (empty form)",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true
        },
        {
          "id": "validation-errors",
          "enabled": true,
          "label": "Form — validation errors",
          "description": "Submit empty form to trigger field errors; captures just the form element",
          "captureMode": "element",
          "selector": "#signupform",
          "includeMobile": true,
          "actions": [
            { "type": "click", "selector": "#submit-sign-up-form" }
          ]
        },
        {
          "id": "filled-form",
          "enabled": false,
          "label": "Full page (form filled)",
          "description": "Form filled with test data",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true,
          "actions": [
            { "type": "input",    "label": "First Name",                               "value": "Test",                        "editable": true },
            { "type": "input",    "label": "Last Name",                                "value": "Test",                        "editable": true },
            { "type": "input",    "label": "Email Address",                            "value": "test@test.com", "editable": true },
            { "type": "input",    "label": "Zip Code",                                 "value": "08043",                         "editable": true },
            { "type": "select",   "label": "Do you or someone you care for have SBS?", "value": "I have been diagnosed with SBS", "editable": true },
            { "type": "input",    "label": "Age of person experiencing bowel problems", "value": "45",                           "editable": true },
            { "type": "checkbox", "label": "I agree to receive email communications",  "value": true }
          ]
        }
      ]
    },

    {
      "id": "sign-up-thank-you",
      "label": "Sign Up — Thank You",
      "path": "/signup-thank-you/",
      "steps": [
        {
          "id": "full-page",
          "enabled": true,
          "label": "Full page",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true
        }
      ]
    }
  ]
}
