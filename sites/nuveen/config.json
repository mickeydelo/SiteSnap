{
  "baseUrl": "https://www.nuveen.com",
  "devices": {
    "desktop": {
      "enabled": true,
      "viewport": { "width": 1440, "height": 900 },
      "deviceScaleFactor": 1
    },
    "mobile": {
      "enabled": true,
      "viewport": { "width": 390, "height": 844 },
      "deviceScaleFactor": 1
    }
  },
  "browser": {
    "actionTimeoutMs": 12000,
    "navigationTimeoutMs": 45000,
    "blockMedia": true,
    "cookies": [
      {
        "name": "siteSwitcherAccept",
        "value": "true",
        "domain": ".nuveen.com",
        "path": "/",
        "secure": true
      },
      {
        "name": "roleRadioButtonCookie",
        "value": "Individual Investor",
        "domain": ".nuveen.com",
        "path": "/",
        "secure": true
      },
      {
        "name": "siteSwitcherSelectedValues",
        "value": "Americas | United States | Individual Investor",
        "domain": ".nuveen.com",
        "path": "/",
        "secure": true
      }
    ]
  },
  "pages": [
    {
      "id": "home",
      "label": "Nuveen Home",
      "path": "/en-us/",
      "readySelector": "body",
      "settleMs": 1200,
      "steps": [
        {
          "id": "cookie-notice",
          "group": "Consent",
          "enabled": true,
          "label": "Cookie notice",
          "description": "Initial Nuveen homepage with the OneTrust cookie notice visible.",
          "captureMode": "viewport",
          "desktop": { "width": 1440, "height": 900 },
          "mobile": { "width": 390, "height": 844 },
          "includeMobile": true
        },
        {
          "id": "clean-viewport",
          "group": "Overview",
          "enabled": true,
          "label": "Clean homepage viewport",
          "description": "Cookie notice accepted; captures the settled first viewport.",
          "captureMode": "viewport",
          "desktop": { "width": 1440, "height": 900 },
          "mobile": { "width": 390, "height": 844 },
          "includeMobile": true,
          "actions": [
            { "type": "acceptCookies", "optional": true, "settle": false }
          ]
        },
        {
          "id": "full-page",
          "group": "Overview",
          "enabled": true,
          "label": "Clean homepage — full page",
          "description": "Complete desktop page after consent, including lazy-loaded content.",
          "captureMode": "fullPage",
          "includeMobile": false,
          "actions": [
            { "type": "acceptCookies", "optional": true, "settle": false }
          ]
        }
      ]
    },
    {
      "id": "high-yield-municipal-bond-fund",
      "label": "High Yield Municipal Bond Fund",
      "path": "/en-us/mutual-funds/nuveen-high-yield-municipal-bond-fund?shareclass=I",
      "readySelector": "#myselect",
      "readyTimeoutMs": 25000,
      "settleMs": 1200,
      "elementHideSelectors": [
        "#global-navigation",
        ".nuv-share-class-selector__sticky-content",
        ".nuv-product-detail-anchor-nav-retail__sticky-content",
        ".nuv-utility-drawer",
        ".article-nuv-socials",
        "#contactusbottom",
        ".nuv-article-content-back-to-top"
      ],
      "actions": [
        { "type": "acceptCookies", "optional": true, "settle": false, "timeoutMs": 800 }
      ],
      "steps": [
        {
          "id": "full-page",
          "group": "Overview",
          "enabled": true,
          "label": "Fund page — full page",
          "description": "The complete default Class I product page with all lazy content loaded.",
          "captureMode": "fullPage",
          "includeMobile": false
