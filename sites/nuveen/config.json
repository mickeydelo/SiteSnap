          "waitFor": { "selector": ".tey-calculator.is-open .tey-calculator-result", "delayMs": 250 },
          "cleanupActions": [
            { "type": "click", "selector": "button.tey-btn--close-overlay.is-open", "settle": false, "timeoutMs": 1200 }
