          "desktop": { "width": 1440, "height": 900 },
          "mobile": { "width": 390, "height": 844 },
          "focusSelector": ".nuv-share-class-selector",
          "focusOffset": -88,
          "includeMobile": true,
          "actions": [
            { "type": "select", "selector": "#myselect", "value": "I | NHMRX", "settle": "network-idle", "delayMs": 500 }
