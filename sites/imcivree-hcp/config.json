{
  "baseUrl": "https://dev.imcivreehcp.com",

  "pages": [
    {
      "id": "home",
      "label": "Home Page",
      "path": "/",
      "includesEntry": true,
      "entryActions": [
        { "type": "acceptCookies" },
        { "type": "click", "text": "I am a US healthcare professional" }
      ],
      "steps": [
        {
          "id": "with-overlays",
          "enabled": true,
          "label": "Cookie bar, interstitial & ISI tray",
          "description": "Raw entry state — no interaction yet",
          "phase": "pre-entry",
          "captureMode": "viewport",
          "desktop": { "width": 1442, "height": 900 },
          "mobile":  { "width": 390,  "height": 800 },
          "includeMobile": true
        },
        {
          "id": "post-dismiss",
          "enabled": true,
          "label": "Overlays dismissed, ISI tray visible",
          "description": "Cookie bar and HCP gate dismissed — ISI tray remains",
          "phase": "post-entry",
          "captureMode": "viewport",
          "desktop": { "width": 1442, "height": 900 },
          "mobile":  { "width": 390,  "height": 800 },
          "includeMobile": true
        },
        {
          "id": "isi-expanded",
          "enabled": true,
          "label": "ISI Expanded",
          "description": "Click Important Safety Information in utility nav to open the ISI drawer",
          "phase": "authenticated",
          "captureMode": "viewport",
          "desktop": { "width": 1442, "height": 900 },
          "mobile":  { "width": 390,  "height": 800 },
          "includeMobile": true,
          "actions": [
            { "type": "click", "text": "Important Safety Information" }
          ]
        },
        {
          "id": "full-page",
          "enabled": true,
          "label": "Full page",
          "description": "Complete scroll capture with ISI tray hidden",
          "phase": "authenticated",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true
        }
      ]
    },

    {
      "id": "resources",
      "label": "Resources",
      "path": "/resources/",
      "steps": [
        {
          "id": "full-page",
          "enabled": true,
          "label": "Full page",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true
        },
        {
          "id": "filtered",
          "enabled": true,
          "label": "Filtered — no resources state",
          "description": "Audience and journey filters applied to surface the no-results message",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true,
          "actions": [
            { "type": "select", "label": "Audience", "value": "For your patient",  "editable": true },
            { "type": "select", "label": "Journey",  "value": "Disease education", "editable": true }
          ],
          "waitFor": "no-results"
        }
      ]
    },

    {
      "id": "get-connected",
      "label": "Get Connected",
      "path": "/get-connected/",
      "steps": [
        {
          "id": "full-page",
          "enabled": true,
          "label": "Full page (empty form)",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true
        },
        {
          "id": "filled-form",
          "enabled": true,
          "label": "Full page (form filled)",
          "description": "Form filled with test data — consent checkbox checked",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true,
          "actions": [
            { "type": "input",    "label": "First name",       "value": "Rhythm",                          "editable": true },
            { "type": "input",    "label": "Last name",        "value": "Health",                          "editable": true },
            { "type": "input",    "label": "Email",            "value": "rhythmtest@coefficient.health",   "editable": true },
            { "type": "input",    "label": "NPI",              "value": "1234567890",                      "editable": true },
            { "type": "checkbox", "label": "Area of interest", "selector": "#area_of_interest_0", "value": true },
            { "type": "checkbox", "label": "Consent", "selector": "#receive_info", "value": true }
          ]
        },
        {
          "id": "thank-you",
          "enabled": true,
          "label": "Thank You modal",
          "description": "Submit the filled form and capture the Thank You confirmation modal",
          "captureMode": "viewport",
          "desktop": { "width": 1442, "height": 900 },
          "mobile":  { "width": 390,  "height": 800 },
          "includeMobile": true,
          "actions": [
            { "type": "click", "text": "Submit" }
          ],
          "waitFor": "network-idle"
        }
      ]
    },

    {
      "id": "sign-up",
      "label": "Sign Up for Updates",
      "path": "/sign-up/",
      "steps": [
        {
          "id": "full-page",
          "enabled": true,
          "label": "Full page (empty form)",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true
        },
        {
          "id": "filled-form",
          "enabled": true,
          "label": "Full page (form filled)",
          "description": "Form filled with test data — consent checkbox checked",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true,
          "actions": [
            { "type": "input",    "label": "First name",  "value": "Rhythm",                        "editable": true },
            { "type": "input",    "label": "Last name",   "value": "Health",                        "editable": true },
            { "type": "input",    "label": "Email",       "value": "rhythmtest@coefficient.health", "editable": true },
            { "type": "checkbox", "label": "Consent",     "value": true }
          ]
        }
      ]
    },

    {
      "id": "404",
      "label": "404 Page",
      "path": "/nothere",
      "steps": [
        {
          "id": "full-page",
          "enabled": true,
          "label": "Full page",
          "captureMode": "fullPage",
          "hideISI": true,
          "includeMobile": true
        }
      ]
    },

    {
      "id": "interstitial-leave",
      "label": "Interstitial (Leave)",
      "type": "external",
      "triggerPage": "/",
      "steps": [
        {
          "id": "capture",
          "enabled": true,
          "label": "Triggered via utility nav",
          "description": "Click 'Visit Patient Site' to open the leaving-site interstitial",
          "captureMode": "viewport",
          "desktop": { "width": 1442, "height": 900 },
          "mobile":  { "width": 390,  "height": 800 },
          "includeMobile": true,
          "trigger": { "type": "click", "text": "Visit Patient Site" }
        }
      ]
    }

  ]
}
